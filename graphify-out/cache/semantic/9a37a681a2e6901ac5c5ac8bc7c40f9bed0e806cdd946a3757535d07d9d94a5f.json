{"nodes": [{"id": "docs_deployments_overview_deployment_snapshot", "label": "Deployment snapshot", "file_type": "concept", "source_file": "docs/deployments/overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Captures every microfrontend (version, hosting, entry point, canary settings, relations), every environment variable and every storage configuration as a copy, not references - editing afterwards does not reach back into it. This is why production can serve 1.2.0 while 1.4.0 is staged for UAT."}, {"id": "docs_deployments_overview_environment_promotion", "label": "Promotion between environments", "file_type": "concept", "source_file": "docs/deployments/overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "There is no dedicated promote button because promotion is just a deployment: select the version live in the source environment and deploy the target. The artifact is not rebuilt or copied - what differs between stages is only the environment variables each snapshot carries."}], "edges": [{"source": "docs_deployments_overview_deployment_snapshot", "target": "docs_deployments_rollback_and_redeploy_rollback", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/deployments/overview.md", "source_location": null, "weight": 1.0}, {"source": "docs_deployments_overview_deployment_snapshot", "target": "docs_integration_overview_integration_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/deployments/overview.md", "source_location": null, "weight": 1.0}, {"source": "docs_deployments_overview_environment_promotion", "target": "docs_deployments_overview_deployment_snapshot", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/deployments/overview.md", "source_l