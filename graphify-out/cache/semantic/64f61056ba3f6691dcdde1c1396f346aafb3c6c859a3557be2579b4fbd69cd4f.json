{"nodes": [{"id": "docs_microfrontends_hosting_options", "label": "Microfrontend Hosting Options (Doc)", "file_type": "document", "source_file": "docs/microfrontends/hosting-options.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_microfrontends_hosting_options_hosting_type", "label": "Hosting Type", "file_type": "concept", "source_file": "docs/microfrontends/hosting-options.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every microfrontend declares where its files live; the hosting type determines how a request for remoteEntry.js is resolved into actual bytes."}, {"id": "docs_microfrontends_hosting_options_hub", "label": "MFE Orchestrator Hub Hosting", "file_type": "concept", "source_file": "docs/microfrontends/hosting-options.md", "source_location": "MFE Orchestrator Hub", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Platform stores the build itself; files land on the server filesystem under MICROFRONTEND_HOST_FOLDER/<projectSlug>-<projectId>/<microfrontendSlug>/<version>/. When self-hosting, mount MICROFRONTEND_HOST_FOLDER on a persistent volume (upload_microfrontends in the reference docker-compose.yaml) or every container restart loses uploaded builds. Best for getting started, internal tools, self-hosted installations."}, {"id": "docs_microfrontends_hosting_options_custom_source", "label": "Custom Source (Own Bucket) Hosting", "file_type": "concept", "source_file": "docs/microfrontends/hosting-options.md", "source_location": "Custom Source (your own bucket)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Build stored in a bucket you own (S3, Azure Blob, GCS) and streamed on request; the bucket does not need to be public because files are fetched server-side with configured credentials and streamed through the serve API. Best for production, compliance, keeping artifacts inside your cloud account. Only appears as an option once the project has at least one storage configured."}, {"id": "docs_microfrontends_hosting_options_custom_url", "label": "Custom URL Hosting", "file_type": "concept", "source_file": "docs/microfrontends/hosting-options.md", "source_location": "Custom URL", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Files already published elsewhere (CDN, static host); MFE Orchestrator only tracks versions and hands the right URL to the host. Upload is rejected. URL placeholders ($version, $microfrontendSlug, $projectId, $projectSlug) are substituted at request time \u2014 $version makes switching a version in the console and deploying enough to repoint users at different CDN files with no host rebuild."}, {"id": "docs_microfrontends_hosting_options_entry_point", "label": "Entry Point", "file_type": "concept", "source_file": "docs/microfrontends/hosting-options.md", "source_location": "Entry point", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Names the file consumers load; defaults to index.js but Module Federation builds usually produce remoteEntry.js (Webpack) or assets/remoteEntry.js (Vite). Always served with Cache-Control: no-cache, no-store, must-revalidate while surrounding hashed assets stay cacheable \u2014 that is what lets a deployment take effect immediately without stale chunks. All served files carry Cross-Origin-Resource-Policy: cross-origin so hosts on other origins can load them."}], "edges": [{"source": "docs_microfrontends_hosting_options", "target": "docs_microfrontends_hosting_options_hosting_type", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/microfrontends/hosting-options.md", "source_location": null, "weight": 1.0}, {"source": "docs_microfrontends_hosting_options", "target": "docs_microfrontends_hosting_options_hub", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/microfrontends/hosting-options.md", "source_location": null, "weight": 1.0}, {"source": "docs_microfrontends_hosting_options", "target": "docs_microfrontends_hosting_options_custom_source", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/microfrontends/hosting-options.md", "source_location": null, "weight": 1.0}, {"source": "docs_microfrontends_hosting_options", "target": "docs_microfrontends_hosting_options_custom_url", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/microfrontends/hosting-options.md", "source_location": null, "weight": 1.0}, {"source": "docs_microfrontends_hosting_options", "target": "docs_microfrontends_hosting_options_entry_point", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/microfrontends/hosting-options.md", "source_location": null, "weight": 1.0}, {"source": "docs_microfrontends_hosting_options_hosting_type", "target": "docs_microfrontends_hosting_options_hub", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/microfrontends/hosting-options.md", "source_location": null, "weight": 1.0}, {"source": "docs_microfrontends_hosting_options_hosting_type", "target": "docs_microfrontends_hosting_options_custom_source", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/microfrontends/hosting-options.md", "source_location": null, "weight": 1.0}, {"source": "docs_microfrontends_hosting_options_hosting_type", "target": "docs_microfrontends_hosting_options_custom_url", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/microfrontends/hosting-options.md", "source_location": null, "weight": 1.0}, {"source": "docs_microfrontends_hosting_options_hub", "target": "docs_self_hosting_environment_variables", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/microfrontends/hosting-options.md", "source_location": "MFE Orchestrator Hub", "weight": 1.0}, {"source": "docs_microfrontends_hosting_options_hub", "target": "docs_self_hosting_docker_compose_stack", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/microfrontends/hosting-options.md", "source_location": "Self-hosting and persistence caution", "weight": 1.0}, {"source": "docs_microfrontends_hosting_options_entry_point", "target": "docs_microfrontends_host_and_remotes_module_federation", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/microfrontends/hosting-options.md", "source_location": "Entry point", "weight": 1.0}], "hyperedges": [{"id": "microfrontend_hosting_type_options", "label": "Microfrontend Hosting Type Options (Hub, Custom Source, Custom URL)", "nodes": ["docs_microfrontends_hosting_options_hosting_type", "docs_microfrontends_hosting_options_hub", "docs_microfrontends_hosting_options_custom_source", "docs_microfrontends_hosting_options_custom_url"], "relation": "form", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/microfrontends/hosting-options.md"}]}