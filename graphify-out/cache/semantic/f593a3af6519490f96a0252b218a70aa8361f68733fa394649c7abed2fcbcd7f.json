{"nodes": [{"id": "docs_core_concepts_project", "label": "Project", "file_type": "concept", "source_file": "docs/core-concepts.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The top-level container and the boundary for authorization: every other object belongs to exactly one project and access is granted per project. Selected in direct API calls via the project-id header."}, {"id": "docs_core_concepts_environment", "label": "Environment", "file_type": "concept", "source_file": "docs/core-concepts.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A deployment stage inside a project (dev, uat, prod). Its domains list lets public endpoints resolve which environment a browser request belongs to from the Referer header, so a single microfrontend URL serves the right version per stage."}, {"id": "docs_core_concepts_microfrontend", "label": "Microfrontend (host or remote)", "file_type": "concept", "source_file": "docs/core-concepts.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A versioned frontend bundle, either a host (shell) or a remote. Parent/child relations declared in the console are turned into the remotes block of the Module Federation configuration."}, {"id": "docs_core_concepts_environment_variable", "label": "Environment variable (global variable)", "file_type": "concept", "source_file": "docs/core-concepts.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A key/value pair scoped to one environment, read at runtime by the browser rather than baked in at build time, so the same artifact can be promoted from uat to prod without a rebuild."}, {"id": "docs_core_concepts_deployment", "label": "Deployment (immutable snapshot)", "file_type": "concept", "source_file": "docs/core-concepts.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The single most important idea in MFE Orchestrator: editing is not deploying. Changes sit in the project configuration until Deploy freezes them into a numbered immutable snapshot and activates it; exactly one is active per environment, and rollback is re-activating an older one."}, {"id": "docs_core_concepts_lifecycle_of_a_change", "label": "Lifecycle of a change (commit to browser)", "file_type": "concept", "source_file": "docs/core-concepts.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Commit, build and upload via CI, version registration, deployment, then serving: the host asks the public serve API which URLs to load and the active deployment answers."}], "edges": [{"source": "docs_core_concepts_project", "target": "docs_core_concepts_environment", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/core-concepts.md", "source_location": null, "weight": 1.0}, {"source": "docs_core_concepts_environment", "target": "docs_core_concepts_environment_variable", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/core-concepts.md", "source_location": null, "weight": 1.0}, {"source": "docs_core_concepts_environment", "target": "docs_core_concepts_deployment", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/core-concepts.md", "source_location": null, "weight": 1.0}, {"source": "docs_core_concepts_project", "target": "docs_core_concepts_microfrontend", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/core-concepts.md", "source_location": null, "weight": 1.0}, {"source": "docs_core_concepts_environment", "target": "docs_environme