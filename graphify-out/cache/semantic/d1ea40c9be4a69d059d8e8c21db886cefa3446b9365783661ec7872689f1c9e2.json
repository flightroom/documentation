{"nodes": [{"id": "docs_project_settings_users_and_roles", "label": "Project Members and Roles (Doc)", "file_type": "document", "source_file": "docs/project-settings/users-and-roles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_project_settings_users_and_roles_roles", "label": "Project Roles (Admin/Editor/Viewer = OWNER/MEMBER/VIEWER)", "file_type": "concept", "source_file": "docs/project-settings/users-and-roles.md", "source_location": "Roles", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Access granted per project; console labels (Admin/Editor/Viewer) differ from API/database names (OWNER/MEMBER/VIEWER). There is no per-environment permission split: an Editor who can deploy dev can deploy prod \u2014 restrict production either via a separate project or by limiting Editor membership. Keep Admins few but never one. Machine access should use API keys (MANAGER/VIEWER roles, expiring, revocable), not shared service users; keys belong to the project, so audit them when a person leaves."}], "edges": [{"source": "docs_project_settings_users_and_roles", "target": "docs_project_settings_users_and_roles_roles", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/project-settings/users-and-roles.md", "source_location": null, "weight": 1.0}, {"source": "docs_project_settings_users_and_roles", "target": "docs_self_hosting_environment_variables", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/project-settings/users-and-roles.md", "source_location": "Email delivery is required", "weight": 1.0}, {"source": "docs_project_settings_users_and_roles", "target": "docs_self_hosting_enable_sso_google", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/project-settings/users-and-roles.md", "source_location": "Authentication