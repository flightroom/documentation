{"nodes": [{"id": "docs_environments_environment_variables_runtime_variables", "label": "Runtime environment variables", "file_type": "concept", "source_file": "docs/environments/environment-variables.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Build-time variables make the artifact environment-specific, so promoting means rebuilding and the thing you tested is not the thing you shipped. Runtime variables let one artifact travel through every stage with the stage supplying configuration. Captured in the deployment snapshot, so a config change is as auditable and reversible as a code change."}, {"id": "docs_environments_environment_variables_public_endpoint_caveat", "label": "Environment variables are not a secret store", "file_type": "rationale", "source_file": "docs/environments/environment-variables.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Variables are served to the browser by a public, unauthenticated endpoint; anyone with the project and environment id can read them. Use them only for public configuration - API base URLs, feature flags, tracking ids, public keys - never secrets."}], "edges": [{"source": "docs_environments_environment_variables_public_endpoint_caveat", "target": "docs_environments_environment_variables_runtime_variables", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/environments/environment-variables.md", "source_location": null, "weight": 1.0}, {"source": "docs_environments_environment_variables_runtime_variables", "target": "docs_integration_runtime_configuration_window_globalconfig", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/environments/environment-variables.md", "source_location": null, "weight": 1.0}, {"source": "docs_environments_environment_variables_runtime_variables",