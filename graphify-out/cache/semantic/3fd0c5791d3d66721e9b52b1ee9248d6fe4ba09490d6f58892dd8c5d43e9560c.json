{"nodes": [{"id": "docs_integration_overview_integration_page", "label": "Integration page", "file_type": "concept", "source_file": "docs/integration/overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Generates, per selected environment and host, the exact snippets a project needs with ids pre-filled; requires an active deployment because there is nothing to integrate against until then. Inject in Repository writes the generated configuration directly into a connected repository."}, {"id": "docs_integration_overview_build_time_configuration", "label": "Build-time configuration model", "file_type": "concept", "source_file": "docs/integration/overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Copy the generated remotes block into the bundler config: simplest, standard Module Federation. URLs contain no version numbers so version bumps are still just deployments, but adding or removing a remote requires a host rebuild. The recommended starting point."}, {"id": "docs_integration_overview_runtime_discovery", "label": "Runtime discovery model", "file_type": "concept", "source_file": "docs/integration/overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The host asks the serve API at boot which remotes exist and registers them dynamically: adding a remote needs no host rebuild, at the cost of dynamic remote loading code and one HTTP request at startup. Teams move to it when the roster of remotes changes often."}], "edges": [{"source": "docs_integration_overview_integration_page", "target": "docs_integration_module_federation_vite_vite_integration", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/integration/overview.md", "source_location": null, "weight": 1.0}, {"source": "docs_integration