{"nodes": [{"id": "docs_buckets_overview_storage_bucket", "label": "Storage (Bucket)", "file_type": "concept", "source_file": "docs/buckets/overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Using your own bucket gives data residency control and your own retention/backup policy, which is the right answer for production and compliance; the hub is for getting started and self-hosted installs. The provider type is fixed at creation."}, {"id": "docs_buckets_overview_server_side_streaming", "label": "Server-side streaming from private buckets", "file_type": "rationale", "source_file": "docs/buckets/overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MFE Orchestrator reads objects server-side with the configured credentials and streams them to browsers itself, so the bucket never needs to be public and never needs CORS configuration - the browser talks to the platform, not to the bucket."}, {"id": "docs_buckets_overview_path_layout", "label": "Deterministic storage path layout", "file_type": "concept", "source_file": "docs/buckets/overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Files land at <path>/<projectSlug>-<projectId>/<microfrontendSlug>/<version>/. The project id in the prefix lets several projects and installations share one bucket without colliding; versions sit side by side and nothing is deleted or overwritten, which is what makes rollback instant."}], "edges": [{"source": "docs_buckets_overview_storage_bucket", "target": "docs_buckets_aws_s3_amazon_s3_storage", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/buckets/overview.md", "source_location": null, "weight": 1.0}, {"source": "docs_buckets_overview_storage_bucket", "target": "docs_buckets_azure_blob_storage_azure_blob