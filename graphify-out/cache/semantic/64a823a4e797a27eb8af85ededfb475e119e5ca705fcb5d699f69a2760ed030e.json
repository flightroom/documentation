{"nodes": [{"id": "docs_microfrontends_host_and_remotes", "label": "Hosts and Remotes in Module Federation (Doc)", "file_type": "document", "source_file": "docs/microfrontends/host-and-remotes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_microfrontends_host_and_remotes_relation_graph", "label": "Microfrontend Relation Graph (Parents/Hosts)", "file_type": "concept", "source_file": "docs/microfrontends/host-and-remotes.md", "source_location": "The relation graph", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The graph is what lets the platform generate Module Federation configuration: a host's remotes are computed as all microfrontends in the active deployment whose parents include that host, each resolved to a concrete URL from its hosting type and frozen version. Consequence: the host's build config contains remote names only \u2014 bumping a remote version in production is a deployment, not a host rebuild. A remote can be a host of other remotes and can have several parents."}, {"id": "docs_microfrontends_host_and_remotes_remote_naming", "label": "Remote Name Derivation from Slug", "file_type": "concept", "source_file": "docs/microfrontends/host-and-remotes.md", "source_location": "Remote naming", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Module Federation remote names cannot contain '/' or '-', so the name is derived from the slug by stripping them (product-catalog -> productcatalog, shop/catalog -> shop_catalog). Prefer dash-free slugs so imports stay readable and unambiguous."}, {"id": "docs_microfrontends_host_and_remotes_shared_dependencies", "label": "Shared Singleton Dependencies", "file_type": "concept", "source_file": "docs/microfrontends/host-and-remotes.md", "source_location": "Shared dependencies", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Generated configs mark react, react-dom and react-router-dom as shared singletons to prevent two copies of React loading \u2014 a failure mode that produces confusing hook errors rather than an obvious crash. Other shared libraries must be added to the shared block of every participating microfrontend, hosts and remotes alike."}, {"id": "docs_microfrontends_host_and_remotes_module_federation", "label": "Module Federation", "file_type": "concept", "source_file": "docs/microfrontends/host-and-remotes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_microfrontends_host_and_remotes", "target": "docs_microfrontends_host_and_remotes_relation_graph", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/microfrontends/host-and-remotes.md", "source_location": null, "weight": 1.0}, {"source": "docs_microfrontends_host_and_remotes", "target": "docs_microfrontends_host_and_remotes_remote_naming", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/microfrontends/host-and-remotes.md", "source_location": null, "weight": 1.0}, {"source": "docs_microfrontends_host_and_remotes", "target": "docs_microfrontends_host_and_remotes_shared_dependencies", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/microfrontends/host-and-remotes.md", "source_location": null, "weight": 1.0}, {"source": "docs_microfrontends_host_and_remotes", "target": "docs_microfrontends_host_and_remotes_module_federation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/microfrontends/host-and-remotes.md", "source_location": null, "weight": 1.0}, {"source": "docs_microfrontends_host_and_remotes_relation_graph", "target": "docs_microfrontends_host_and_remotes_module_federation", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/microfrontends/host-and-remotes.md", "source_location": "Why the graph matters", "weight": 1.0}, {"source": "docs_microfrontends_host_and_remotes_remote_naming", "target": "docs_microfrontends_overview_slug", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/microfrontends/host-and-remotes.md", "source_location": "Remote naming", "weight": 1.0}, {"source": "docs_microfrontends_host_and_remotes_shared_dependencies", "target": "docs_microfrontends_host_and_remotes_module_federation", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/microfrontends/host-and-remotes.md", "source_location": "Shared dependencies", "weight": 1.0}], "hyperedges": []}