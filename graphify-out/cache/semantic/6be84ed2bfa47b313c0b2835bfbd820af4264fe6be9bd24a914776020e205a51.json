{"nodes": [{"id": "docs_microfrontends_canary_releases", "label": "Canary Releases for Microfrontends (Doc)", "file_type": "document", "source_file": "docs/microfrontends/canary-releases.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_microfrontends_canary_releases_canary_release", "label": "Canary Release", "file_type": "concept", "source_file": "docs/microfrontends/canary-releases.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Serves a new version to a fraction of traffic per microfrontend without any host application change; the host receives one URL per remote and does not know which side of the split it got, so no client-side logic is required. Feature is experimental: session-based distribution works, but user-based and cookie-based targeting are incomplete and the Canary Users page is marked Coming soon."}, {"id": "docs_microfrontends_canary_releases_canary_targeting", "label": "Canary Targeting Types (Sessions / User / Cookie)", "file_type": "concept", "source_file": "docs/microfrontends/canary-releases.md", "source_location": "Who \u2014 the canary type", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_microfrontends_canary_releases_canary_deployment_type", "label": "Canary Deployment Type (Based on Version / Based on URL)", "file_type": "concept", "source_file": "docs/microfrontends/canary-releases.md", "source_location": "What \u2014 the deployment type", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Based on version is the natural choice when the canary is the next build; based on URL is useful when the candidate lives on separate infrastructure (preview environment, different CDN) and you want to route a traffic slice there without registering it as a version."}, {"id": "docs_microfrontends_canary_releases_environment_based_rollout", "label": "Environment-based Progressive Rollout (Canary Alternative)", "file_type": "rationale", "source_file": "docs/microfrontends/canary-releases.md", "source_location": "Practical advice", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Until canary support stabilises, the most reliable progressive rollout is to mirror production in an environment, route a traffic subset via your own routing/DNS, deploy the candidate there and promote by deploying the same version to production \u2014 it uses only the fully implemented deployment mechanics and keeps rollback a single redeploy away."}], "edges": [{"source": "docs_microfrontends_canary_releases", "target": "docs_microfrontends_canary_releases_canary_release", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/microfrontends/canary-releases.md", "source_location": null, "weight": 1.0}, {"source": "docs_microfrontends_canary_releases", "target": "docs_microfrontends_canary_releases_canary_targeting", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/microfrontends/canary-releases.md", "source_location": null, "weight": 1.0}, {"source": "docs_microfrontends_canary_releases", "target": "docs_microfrontends_canary_releases_canary_deployment_type", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/microfrontends/canary-releases.md", "source_location": null, "weight": 1.0}, {"source": "docs_microfrontends_canary_releases", "target": "docs_microfrontends_canary_releases_environment_based_rollout", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/microfrontends/canary-releases.md", "source_location": null, "weight": 1.0}, {"source": "docs_microfrontends_canary_releases_canary_targeting", "target": "docs_microfrontends_canary_releases_canary_release", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/microfrontends/canary-releases.md", "source_location": null, "weight": 1.0}, {"source": "docs_microfrontends_canary_releases_canary_deployment_type", "target": "docs_microfrontends_canary_releases_canary_release", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/microfrontends/canary-releases.md", "source_location": null, "weight": 1.0}, {"source": "docs_microfrontends_canary_releases_canary_deployment_type", "target": "docs_microfrontends_hosting_options_hosting_type", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/microfrontends/canary-releases.md", "source_location": "What \u2014 the deployment type", "weight": 1.0}, {"source": "docs_microfrontends_canary_releases_environment_based_rollout", "target": "docs_microfrontends_canary_releases_canary_release", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/microfrontends/canary-releases.md", "source_location": "Practical advice", "weight": 1.0}], "hyperedges": []}