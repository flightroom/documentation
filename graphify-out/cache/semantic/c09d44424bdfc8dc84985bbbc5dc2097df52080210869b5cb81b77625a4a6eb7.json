{"nodes": [{"id": "docs_ci_cd_api_keys_api_key", "label": "API Key", "file_type": "concept", "source_file": "docs/ci-cd/api-keys.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Authenticates a machine against a single project, sent in the api-key header (query parameter discouraged because it leaks into logs). Shown once and stored hashed. One key per consumer keeps the blast radius correct; a leaked MANAGER key can publish arbitrary JavaScript to production."}, {"id": "docs_ci_cd_api_keys_mandatory_expiry", "label": "Mandatory API key expiry", "file_type": "rationale", "source_file": "docs/ci-cd/api-keys.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "There is no non-expiring key by design: a credential that never expires is one nobody ever rotates. The trade-off is that an expired key fails pipelines at upload time, after a successful build, which is confusing if the expiry was forgotten."}, {"id": "docs_ci_cd_api_keys_manager_role", "label": "MANAGER key role", "file_type": "concept", "source_file": "docs/ci-cd/api-keys.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_ci_cd_api_keys_mandatory_expiry", "target": "docs_ci_cd_api_keys_api_key", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ci-cd/api-keys.md", "source_location": null, "weight": 1.0}, {"source": "docs_ci_cd_api_keys_manager_role", "target": "docs_ci_cd_api_keys_api_key", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ci-cd/api-keys.md", "source_location": null, "weight": 1.0}, {"source": "docs_ci_cd_api_keys_api_key", "target": "docs_ci_cd_manual_upload_upload_endpoint", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ci-cd/api-keys.md", "source_location": null, "weight": 1.0}], "hyperedges": []}