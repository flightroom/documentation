{"nodes": [{"id": "docs_microfrontends_create_a_microfrontend", "label": "Create a Microfrontend (Doc)", "file_type": "document", "source_file": "docs/microfrontends/create-a-microfrontend.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_microfrontends_create_a_microfrontend_template_creation", "label": "Create From Template", "file_type": "concept", "source_file": "docs/microfrontends/create-a-microfrontend.md", "source_location": "From a template (recommended)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fastest path from nothing to a deployable microfrontend: creates the repository, pushes the template as initial commit, injects a provider-specific build pipeline pre-filled with slug and API base URL, and creates an API key stored as a provider secret \u2014 so the generated pipeline works on its first run with no key copied by hand."}, {"id": "docs_microfrontends_create_a_microfrontend_from_scratch", "label": "Create From Scratch", "file_type": "concept", "source_file": "docs/microfrontends/create-a-microfrontend.md", "source_location": "From scratch", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "For code that already exists: same general information plus hosting configuration (Hub, Custom Source, Custom URL). MFE Orchestrator will not add a pipeline to a repository it did not create \u2014 copy one from template-pipelines and create an API key yourself."}, {"id": "docs_microfrontends_create_a_microfrontend_api_key_secret", "label": "MICROFRONTEND_ORCHESTRATOR_API_KEY Secret", "file_type": "concept", "source_file": "docs/microfrontends/create-a-microfrontend.md", "source_location": "What happens behind the scenes", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "API key with the MANAGER role, valid one year, stored in the Git provider as secret MICROFRONTEND_ORCHESTRATOR_API_KEY (on Azure DevOps inside the MFE_ORCHESTRATOR_SECRETS variable group); it is the credential the generated pipeline uses to upload build artifacts."}], "edges": [{"source": "docs_microfrontends_create_a_microfrontend", "target": "docs_microfrontends_create_a_microfrontend_template_creation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/microfrontends/create-a-microfrontend.md", "source_location": null, "weight": 1.0}, {"source": "docs_microfrontends_create_a_microfrontend", "target": "docs_microfrontends_create_a_microfrontend_from_scratch", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/microfrontends/create-a-microfrontend.md", "source_location": null, "weight": 1.0}, {"source": "docs_microfrontends_create_a_microfrontend", "target": "docs_microfrontends_create_a_microfrontend_api_key_secret", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/microfrontends/create-a-microfrontend.md", "source_location": null, "weight": 1.0}, {"source": "docs_microfrontends_create_a_microfrontend", "target": "docs_repositories_connect_github", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/microfrontends/create-a-microfrontend.md", "source_location": "Prerequisites", "weight": 1.0}, {"source": "docs_microfrontends_create_a_microfrontend", "target": "docs_repositories_connect_gitlab", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/microfrontends/create-a-microfrontend.md", "source_location": "Prerequisites", "weight": 1.0}, {"source": "docs_microfrontends_create_a_microfrontend", "target": "docs_repositories_connect_azure_dev_ops", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/microfrontends/create-a-microfrontend.md", "source_location": "Prerequisites